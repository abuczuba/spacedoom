# Ghostty test profile — Spacemacs Dark / Czuba
# Based on ~/.config/doom/config.el in the user's June 2026 backup,
# plus the upstream spacemacs-theme dark palette.
# Independent profile: no shell/tmux overrides, no startup commands.

# Original Doom and backed-up Alacritty both used Source Code Pro.
font-family = Source Code Pro
font-family = FiraCode Nerd Font
font-size = 12

# Calm, near-borderless Emacs-inspired frame.
macos-titlebar-style = transparent
window-padding-x = 15
window-padding-y = 15
macos-option-as-alt = true
scrollback-limit = 10000000

# Exact Spacemacs Dark true-color foundation.
background = #292b2e
foreground = #b2b2b2
selection-background = #444155
selection-foreground = #e3dedd

# Normal-mode Evil cursor in user's Doom config: DarkGoldenrod2.
cursor-style = block
cursor-style-blink = false
cursor-color = #eead0e
cursor-text = #292b2e

# ANSI 16-color mapping, derived from the Spacemacs Dark color roles.
# ANSI slots are a reasoned mapping, not an upstream Spacemacs terminal palette.
palette = 0=#212026
palette = 1=#f2241f
palette = 2=#67b11d
palette = 3=#b1951d
palette = 4=#4f97d7
palette = 5=#bc6ec5
palette = 6=#2aa1ae
palette = 7=#b2b2b2
palette = 8=#545557
palette = 9=#e0211d
palette = 10=#86dc2f
palette = 11=#dc752f
palette = 12=#7590db
palette = 13=#c56ec3
palette = 14=#28def0
palette = 15=#e3dedd

command = /opt/homebrew/bin/fish -l -c 'tmux new-session -A -s main; exec fish'

# >>> czuba-navigation-v1 >>>
# Super is Command on macOS. Ghostty sends Ctrl-F (0x06) and one tmux key.
# No global OS hotkeys and no Alt/Control hijacking inside Emacs or Fish.
keybind = super+shift+h=text:\x06h
keybind = super+shift+j=text:\x06j
keybind = super+shift+k=text:\x06k
keybind = super+shift+l=text:\x06l

# Original Alacritty Command+number muscle memory.
keybind = super+digit_1=text:\x06\x31
keybind = super+digit_2=text:\x06\x32
keybind = super+digit_3=text:\x06\x33
keybind = super+digit_4=text:\x06\x34
keybind = super+digit_5=text:\x06\x35
keybind = super+digit_6=text:\x06\x36
keybind = super+digit_7=text:\x06\x37
keybind = super+digit_8=text:\x06\x38
keybind = super+digit_9=text:\x06\x39

keybind = super+shift+v=text:\x06v
keybind = super+shift+s=text:\x06s
keybind = super+shift+n=text:\x06\x63
keybind = super+shift+z=text:\x06z
keybind = super+shift+a=text:\x06w
keybind = super+shift+x=text:\x06x
# <<< czuba-navigation-v1 <<<
keybind = super+shift+y=text:\x06Y

# Local shortcut reference. Preserve command palette on Cmd+Ctrl+P.
keybind = super+ctrl+p=toggle_command_palette
keybind = super+shift+p=text:\x06?
